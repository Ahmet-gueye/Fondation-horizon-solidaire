# =====================================================================
# Fondation Horizon Solidaire : variables d'environnement
# Copiez ce fichier en `.env.local` (développement) ou configurez ces
# variables chez votre hébergeur (Vercel > Settings > Environment Variables).
# NE COMMITTEZ JAMAIS de vraies valeurs.
# =====================================================================

# URL publique du site (sans / final). Utilisée pour le SEO, le sitemap
# et la vérification d'origine des formulaires. À définir AVANT `npm run build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Espace d'administration (/admin)
# ---------------------------------------------------------------------
# Secret de signature des sessions : 32 caractères aléatoires minimum.
# Exemple pour en générer un : openssl rand -base64 48
AUTH_SECRET=

# Code à usage unique pour créer le PREMIER administrateur sur /admin/installation
# (16 caractères minimum, choisi par vous). Peut être retiré ensuite.
ADMIN_SETUP_TOKEN=

# Base de données PostgreSQL (obligatoire sur Vercel). Ajoutée automatiquement
# par Vercel > Storage > Neon ; le site accepte aussi POSTGRES_URL.
# Sans cette variable, en local, les données vont dans DATA_DIR/db/.
DATABASE_URL=

# Stockage des images et PDF importés (obligatoire sur Vercel). Ajouté
# automatiquement par Vercel > Storage > Blob (créer le magasin en accès « Private »).
# Sans cette variable, en local, les fichiers vont dans DATA_DIR/uploads/.
BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private   # « public » seulement si votre magasin Blob est public

# Dossier local des données (développement ou serveur avec disque persistant).
DATA_DIR=./data

# Facultatif : webhook HTTPS (Make, Zapier, n8n, service d'e-mail…) qui reçoit
# une copie de chaque message des formulaires de contact.
FORMS_WEBHOOK_URL=

# ---------------------------------------------------------------------
# PayTech : PAS ENCORE UTILISÉ. Le don en ligne est désactivé.
# À renseigner seulement lors de l'activation (voir README,
# « Activer PayTech plus tard »). Clés lues uniquement côté serveur.
# ---------------------------------------------------------------------
# PAYTECH_API_KEY=
# PAYTECH_API_SECRET=
# PAYTECH_ENV=test            # test, puis prod après validation
# PAYTECH_TARGET_PAYMENT=     # moyens confirmés par PayTech, séparés par des virgules
# PAYTECH_API_BASE=https://paytech.sn/api
