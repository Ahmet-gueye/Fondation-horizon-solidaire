# =====================================================================
# Fondation Horizon Solidaire : variables d'environnement
# Copiez ce fichier en `.env.local` (développement) ou configurez ces
# variables chez votre hébergeur. NE COMMITTEZ JAMAIS de vraies clés.
# =====================================================================

# URL publique du site (sans / final). Utilisée pour le SEO, le sitemap
# et les URL de retour PayTech. À définir AVANT `npm run build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# PayTech (https://paytech.sn) : clés lues UNIQUEMENT côté serveur.
# ---------------------------------------------------------------------
# simulation : aucun appel à PayTech, parcours de démonstration (par défaut)
# test       : environnement de test PayTech (petit montant de test débité, usage interne)
# prod       : paiements réels (compte PayTech activé obligatoire)
# Sans clé API ni secret, le site reste automatiquement en simulation.
PAYTECH_MODE=simulation

# Clés disponibles dans votre tableau de bord PayTech (Paramètres > API).
PAYTECH_API_KEY=
PAYTECH_API_SECRET=

# Facultatif : moyens de paiement proposés (valeurs exactes de la doc PayTech,
# séparées par des virgules), ex. : Orange Money, Wave, Free Money, Carte Bancaire
# Vide = tous les moyens activés sur votre compte.
PAYTECH_TARGET_PAYMENT=

# Facultatif : URL de base de l'API (ne changer que sur indication de PayTech).
# PAYTECH_API_BASE=https://paytech.sn/api

# ---------------------------------------------------------------------
# Stockage et formulaires
# ---------------------------------------------------------------------
# Dossier où sont enregistrés les dons et messages (fichiers JSON, accès restreint).
DATA_DIR=./data

# Facultatif : webhook HTTPS (Make, Zapier, n8n, service d'e-mail…) qui reçoit
# une copie de chaque message des formulaires de contact.
FORMS_WEBHOOK_URL=
